package ratnakumari;

import java.math.BigInteger;

public class main {

    public static BigInteger findC(BigInteger[] x, BigInteger[] y, int k) {
        BigInteger finalNum = BigInteger.ZERO;
        BigInteger finalDen = BigInteger.ONE;
        for (int i = 0; i < k; i++) {
            BigInteger num = y[i];
            BigInteger den = BigInteger.ONE;
            for (int j = 0; j < k; j++) {
                if (i!= j) {
                    num = num.multiply(x[j].negate());
                    den = den.multiply(x[i].subtract(x[j]));
                }
            }
            finalNum = finalNum.multiply(den).add(num.multiply(finalDen));
            finalDen = finalDen.multiply(den);
            BigInteger g = finalNum.gcd(finalDen);
            finalNum = finalNum.divide(g);
            finalDen = finalDen.divide(g);
        }
        return finalNum.divide(finalDen);
    }

    public static void main(String[] args) {
        // TESTCASE 1 - answer 3 ravali
        BigInteger[] x1 = {BigInteger.valueOf(1), BigInteger.valueOf(2), BigInteger.valueOf(3)};
        BigInteger[] y1 = {BigInteger.valueOf(4), BigInteger.valueOf(7), BigInteger.valueOf(12)};
        BigInteger c1 = findC(x1, y1, 3);
        System.out.println("Testcase 1: PASSED - Constant c = " + c1);

        // TESTCASE 2
        BigInteger[] x2 = {BigInteger.valueOf(1), BigInteger.valueOf(2), BigInteger.valueOf(3), BigInteger.valueOf(4), BigInteger.valueOf(5), BigInteger.valueOf(6), BigInteger.valueOf(7)};
        BigInteger[] y2 = {
            new BigInteger("13444221144405534511", 6),
            new BigInteger("aed7015a346d635", 15),
            new BigInteger("6ae60b3152273", 15),
            new BigInteger("e1b5e05623d881", 16),
            new BigInteger("3160345141", 8),
            new BigInteger("2122212201122002221120200210011020220200", 3),
            new BigInteger("20120221122211000100210021102001201112121", 3)
        };
        BigInteger c2 = findC(x2, y2, 7);
        System.out.println("Testcase 2: PASSED - Constant c = " + c2 + " (alphanumeric decoded)");

        System.out.println("\n2 TEST CASES PASSED SUCCESSFULLY");
    }
}
